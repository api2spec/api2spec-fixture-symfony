{
  "name": "api2spec/fixture-symfony",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^7.0",
    "symfony/http-kernel": "^7.0",
    "symfony/routing": "^7.0",
    "symfony/yaml": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "symfony/browser-kit": "^7.0",
    "symfony/css-selector": "^7.0",
    "symfony/phpunit-bridge": "^7.0"
  }
}
